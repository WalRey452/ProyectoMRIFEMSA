# ============================================================
# .env.example — Registro MRI v2.0
# FEMSA Salud CSIRT
#
# Este archivo es una PLANTILLA. No contiene credenciales reales.
# DevOps debe crear el archivo .env real con los valores de producción
# y guardarlo en AWS Secrets Manager o Parameter Store.
# ============================================================

# ─── Aplicación ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
TZ=America/Santiago

# ─── Base de Datos PostgreSQL (AWS RDS) ──────────────────────
DB_HOST=REEMPLAZAR_CON_ENDPOINT_RDS
DB_PORT=5432
DB_USERNAME=mri_user
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO
DB_DATABASE=registro_mri
DB_SSL=true
# ⚠️ IMPORTANTE: Siempre debe ser "false" en producción
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── JWT — Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REEMPLAZAR_CON_TOKEN_ALEATORIO_DE_64_BYTES
JWT_EXPIRATION=8h
JWT_REFRESH_SECRET=REEMPLAZAR_CON_OTRO_TOKEN_ALEATORIO_DE_64_BYTES
JWT_REFRESH_EXPIRATION=7d

# ─── Redis (AWS ElastiCache) ──────────────────────────────────
REDIS_HOST=REEMPLAZAR_CON_ENDPOINT_ELASTICACHE
REDIS_PORT=6379

# ─── Almacenamiento de archivos ───────────────────────────────
UPLOAD_DIR=/app/uploads

# ─── Email / SMTP Corporativo ─────────────────────────────────
SMTP_HOST=REEMPLAZAR_CON_SERVIDOR_SMTP
SMTP_PORT=587
SMTP_USER=REEMPLAZAR_CON_USUARIO_SMTP
SMTP_PASS=REEMPLAZAR_CON_PASSWORD_SMTP
SMTP_FROM=CSIRT FEMSA Salud <csirt@femsasalud.com>

# ─── URLs y CORS ─────────────────────────────────────────────
FRONTEND_URL=https://REEMPLAZAR_CON_DOMINIO_PRODUCCION
CORS_ORIGINS=https://REEMPLAZAR_CON_DOMINIO_PRODUCCION

# ─── Políticas de seguridad ───────────────────────────────────
PASSWORD_EXPIRY_DAYS=60
PASSWORD_HISTORY_COUNT=5
MAX_LOGIN_ATTEMPTS=5
PUPPETEER_NO_SANDBOX=true
